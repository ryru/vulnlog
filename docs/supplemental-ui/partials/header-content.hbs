{{#if env.SITE_SEARCH_PROVIDER}}
<script>
  // Press "/" anywhere outside a text field to jump to the search box.
  document.addEventListener('keydown', function (e) {
    if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) return
    var target = e.target
    if (target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return
    var input = document.getElementById('search-input')
    if (!input) return
    e.preventDefault()
    input.focus()
    input.select()
  })
</script>
{{/if}}
<script>
  // Theme toggle: system, light, dark. The choice is stored in localStorage. "System" removes it,
  // so the CSS follows prefers-color-scheme again.
  (function () {
    var KEY = 'vulnlog-theme'
    var ORDER = ['system', 'light', 'dark']
    var button = document.querySelector('.vl-theme-toggle')
    if (!button) return
    var label = button.querySelector('.vl-theme-toggle-label')
    function apply (mode) {
      var root = document.documentElement
      if (mode === 'system') delete root.dataset.theme
      else root.dataset.theme = mode
      var next = ORDER[(ORDER.indexOf(mode) + 1) % ORDER.length]
      button.dataset.mode = mode
      button.title = 'Theme: ' + mode + '. Switch to ' + next + '.'
      button.setAttribute('aria-label', button.title)
      label.textContent = 'Theme: ' + mode
    }
    var stored = document.documentElement.dataset.theme
    apply(stored === 'light' || stored === 'dark' ? stored : 'system')
    button.addEventListener('click', function () {
      var mode = ORDER[(ORDER.indexOf(button.dataset.mode) + 1) % ORDER.length]
      try {
        if (mode === 'system') localStorage.removeItem(KEY)
        else localStorage.setItem(KEY, mode)
      } catch (e) {}
      apply(mode)
    })
  })()
</script>
